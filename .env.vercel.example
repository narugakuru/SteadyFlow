# ======================================================
# Vercel + Neon PostgreSQL 配置模板
# 用法：复制为 .env.vercel，填入真实值后在 Vercel 导入
# Vercel Dashboard → Settings → Environment Variables → Import .env
# ======================================================

# 数据库类型：Vercel 固定用 postgres
DB_TYPE=postgres

# Neon 连接串
# 获取：neon.tech → 项目 → Connection Details → 选 "Neon serverless" 驱动 → 复制
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# Auth.js 密钥（与本地保持不同的随机字符串）
# 生成：node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=your-auth-secret-here

# 生产环境回调地址（部署后填入实际 Vercel 域名）
AUTH_URL=https://your-app.vercel.app

# 定时任务鉴权密钥（Vercel Cron 调用 /api/cron/netvalue 时使用）
CRON_SECRET=your-cron-secret-here

# 全局 EODHD API Key（可选）
# 用户设置中的 EODHD API Key 优先；未配置用户 key 时使用此环境变量作为报价回退。
EODHD_API_KEY=your-eodhd-api-key

# GitHub OAuth App（在 github.com/settings/developers 创建）
# Callback URL 填：https://your-app.vercel.app/api/auth/callback/github
GITHUB_ID=your-github-client-id
GITHUB_SECRET=your-github-client-secret
