# ======================================================
# 本地开发配置模板（SQLite）
# 复制为 .env 后填入实际值，用于本地 npm run dev
# ======================================================

# 数据库类型：本地固定用 sqlite
DB_TYPE=sqlite

# Auth.js 密钥（任意随机字符串）
# 生成：node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=your-auth-secret-here

# 本地开发回调地址
AUTH_URL=http://localhost:3000

# 定时任务鉴权密钥（调用 /api/cron/netvalue 时使用）
# 建议使用高熵随机字符串
CRON_SECRET=your-cron-secret-here

# 全局 EODHD API Key（可选）
# 用户设置中的 EODHD API Key 优先；未配置用户 key 时使用此环境变量作为报价回退。
EODHD_API_KEY=your-eodhd-api-key

# GitHub OAuth App（在 github.com/settings/developers 创建）
# Callback URL 填：http://localhost:3000/api/auth/callback/github
GITHUB_ID=your-github-client-id
GITHUB_SECRET=your-github-client-secret

# 默认管理员账号（数据迁移脚本使用）
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=change-me-123456
